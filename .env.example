# Kick WebSocket listener (OAuth/Webhook yok)
# Baslangicta manuel kimlikler zorunlu
KICK_BROADCASTER_USER_ID=
KICK_CHATROOM_ID=

# Opsiyonel: kanal bilgisi icin slug (zorunlu degil)
KICK_BROADCASTER_SLUG=

# Komut yetkilendirme (virgulle ayrilmis username listesi)
KICK_WHITELIST=

# Opsiyonel WebSocket ayarlari (genelde dokunma)
KICK_WS_APP_KEY=32cbd69e4b950bf97679
KICK_WS_CLUSTER=us2
KICK_WS_PROTOCOL=7
KICK_WS_CLIENT=js
KICK_WS_VERSION=8.4.0
KICK_WS_RECONNECT_BASE_MS=2000
KICK_WS_RECONNECT_MAX_MS=30000
KICK_WS_PING_INTERVAL_MS=45000

# Admin panel event log gecmisi (diskte tutulur)
ADMIN_EVENT_HISTORY_MAX=2000
ADMIN_EVENT_HISTORY_DEFAULT_LIMIT=300

# Docker + Caddy ayarlari
DOMAIN=your-domain.com
ADMIN_USER=moderator
# Ciktiyi su komutla uretebilirsin:
# docker run --rm caddy:2.8-alpine caddy hash-password --plaintext "sifren"
ADMIN_PASSWORD_HASH=

# Write endpoint korumasi (production icin zorunlu)
# Guclu ve uzun rastgele bir deger kullan.
STATE_WRITE_API_KEY=CHANGE_ME_WITH_LONG_RANDOM_VALUE

# CORS allowlist (virgulle ayir)
# Ornek: https://your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
